---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseHead from '@/components/BaseHead.astro';
import { SITE } from '@/site.config';
import { formatDate } from '@/utils/formatDate';
import '@/styles/global.css';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, role, date, tags, hero, heroVideo, heroAlt, heroSize, url, repo, links } =
  entry.data;
const { Content } = await render(entry);
const formattedDate = formatDate(date);
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead title={title} description={summary} image={hero ?? ''} />
  </head>
  <body class="academic-page">
    <main class="academic-detail-shell">
      <nav class="academic-detail-nav" aria-label="Project navigation">
        <a class="academic-detail-name" href="/">Haoran (Cris) Wang</a>
        <a href="/">Home</a>
      </nav>

      <article class="academic-detail">
        <header class="academic-detail-header">
          <p class="academic-kicker">Selected work</p>
          <h1>{title}</h1>
          <p class="academic-detail-summary">{summary}</p>

          <dl class="academic-detail-meta">
            <div>
              <dt>Role</dt>
              <dd>{role}</dd>
            </div>
            <div>
              <dt>Date</dt>
              <dd><time datetime={date.toISOString()}>{formattedDate}</time></dd>
            </div>
            {
              tags.length > 0 && (
                <div>
                  <dt>Topics</dt>
                  <dd>{tags.join(' · ')}</dd>
                </div>
              )
            }
          </dl>
        </header>

        {
          hero && (
            <figure class:list={['academic-detail-hero', `academic-detail-hero--${heroSize}`]}>
              <img src={hero} alt={heroAlt ?? title} loading="eager" />
            </figure>
          )
        }
        {
          heroVideo && (
            <figure class="academic-detail-hero academic-detail-hero--video">
              <video
                src={heroVideo}
                aria-label={heroAlt ?? title}
                controls
                muted
                playsinline
                preload="auto"
              />
            </figure>
          )
        }

        <div class="academic-detail-content prose">
          <Content />
        </div>

        {
          (url || repo || links.length > 0) && (
            <nav class="academic-detail-links" aria-label="Project links">
              {url && (
                <a href={url} target="_blank" rel="noreferrer">
                  Visit live
                </a>
              )}
              {repo && (
                <a href={repo} target="_blank" rel="noreferrer">
                  View source
                </a>
              )}
              {links.map((link) => (
                <a href={link.url} target="_blank" rel="noreferrer">
                  {link.label}
                </a>
              ))}
            </nav>
          )
        }
      </article>

      <footer class="academic-footer">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <p>© {new Date().getFullYear()} {SITE.name}</p>
      </footer>
    </main>
  </body>
</html>
